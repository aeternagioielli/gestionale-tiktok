# PostgreSQL connection string. Keep real credentials only in a local .env file.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aeterna_os?schema=public"

# Optional application URL used by future integrations.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo data is opt-in and is never inserted automatically.
AETERNA_DEMO_MODE="false"

# Shopify Admin GraphQL API. Keep real credentials only in the local .env file.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2026-10"

# Required before production: application login credentials for the app and API routes.
# Use a long random password and serve only over HTTPS.
AETERNA_AUTH_USERNAME="aeterna-admin"
AETERNA_AUTH_PASSWORD="replace-with-a-long-random-password"

# Required in production for persistent signed sessions. Keep it server-side.
AETERNA_SESSION_SECRET="replace-with-a-long-random-secret"
